#: inc/profile.class.php:74 inc/ticket.class.php:48
msgid "Transfer Ticket Entity"
msgstr "Transferência de chamados entre entidades"

#: inc/profile.class.php:74
msgid "Change rights"
msgstr "Mudar permissões"

#: inc/profile.class.php:77
msgid "Using entity transfer"
msgstr "Usando transferência de entidade"

#: inc/profile.class.php:89
msgid "Save"
msgstr "Salvar"

#: inc/profile.php:50 inc/profile.php:63
msgid "Item successfully updated"
msgstr "Item atualizado com sucesso"

#: src/Controller/EntityController.php
msgid "Item successfully updated: %s"
msgstr "Item atualizado com sucesso: %s"

#: inc/ticket.class.php:210
msgid "Error, please reload the page."
msgstr "Erro, por favor atualizar a página."

#: inc/ticket.class.php:211
msgid "If the problem persists, you can try to empty the cache by doing CTRL + F5."
msgstr "Se o problema persistir, você pode tentar esvaziar o cache através das teclas CTRL + F5."

#: inc/ticket.class.php:216
msgid "Select ticket entity to transfer"
msgstr "Selecione a entidade para a qual transferir o chamado"

#: inc/ticket.class.php:218
msgid "Choose your entity"
msgstr "Escolha sua entidade"

#: inc/ticket.class.php:227
msgid "Select the group to assign"
msgstr "Selecione o grupo para atribuir"

#: inc/ticket.class.php:229
msgid "Choose your group"
msgstr "Escolha seu grupo"

#: inc/ticket.class.php:250
msgid "Confirm transfer ?"
msgstr "Conformar transferência?"

#: inc/ticket.class.php:251
msgid "Once the transfer has been completed, the ticket will remain visible only if you have the required rights."
msgstr "Uma vez que a transferência tiver sido completa, o ticket será visível somente se você tiver as permissões corretas."

#: inc/ticket.class.php:252
msgid "Cancel"
msgstr "Cancelar"

#: inc/ticket.class.php:253 inc/ticket.class.php:244
msgid "Confirm"
msgstr "Confirmar"

#: inc/ticket.php:125
msgid "Please select a valid entity"
msgstr "Por favor selecione uma entidade válida"

#: inc/ticket.php:135
msgid "Please select a valid group"
msgstr "Por favor selecione um grupo válido"

#: inc/ticket.php:181
msgid "Transferred to entity"
msgstr "Transferido para a entidade"

#: inc/ticket.php:181
msgid "in the group"
msgstr "no grupo"

#: inc/ticket.php:185
msgid "Successful transfer for ticket n° : "
msgstr "Transferência feita com sucesso para o ticket n° : "

#: inc/ticket.php:197
msgid "Transfer canceled"
msgstr "Transferência cancelada"

#: inc/ticket.class.php:266
msgid "Unauthorized transfer on closed ticket."
msgstr "Não é possível transferir um ticket cujo status é fechado."

#: inc/ticket.class.php:436 inc/ticket.php:357
msgid "Please explain your transfer"
msgstr "Por favor apresentar mais dados sobre sua transferência"

#: inc/ticket.php:266
msgid "You must be assigned to the ticket to be able to transfer it"
msgstr "Você precisa estar atribuído ao ticket para ser capaz de transferi-lo"

#: src/Profile.php
msgid "Authorized entity transfer"
msgstr "Autorizar transferência de chamados entre entidades"

#: src/Profile.php
msgid "Transfer authorized without assignment of technician or associated group"
msgstr "Autorizar transferência sem atribuir a um técnico ou grupo"

#: src/Profile.php
msgid "Active"
msgstr "Ativo"

#: templates/entity.html.twig
msgid "Settings Transfer Ticket Entity"
msgstr "Configurações da transferência de chamados entre entidades"

#: templates/entity.html.twig
msgid "Allow Transfer function"
msgstr "Permitir transferência de chamados"

#: templates/entity.html.twig
msgid "Assigned group required"
msgstr "Exigir atribuição a um grupo"

#: templates/entity.html.twig
msgid "Justification required"
msgstr "Exigir justificativa"

#: templates/entity.html.twig
msgid "Keep category after transfer"
msgstr "Manter a categoria após a transferência"

#: templates/entity.html.twig
msgid "Default category"
msgstr "Categoria padrão"

#: templates/entity.html.twig
msgid "Assigned group"
msgstr "Grupo atribuído"

#: templates/entity.html.twig
msgid "If group assignment is not required, the ticket will be transferred without a group and all assigned groups will be removed."
msgstr "Se não exigir a atribuição a um grupo, o chamado será transferido sem grupo e todos os grupos atribuídos serão removidos."

#: templates/entity.html.twig
msgid "During transfer, the ticket will always be assigned to this group, and the user will not be able to change it."
msgstr "Durante a transferência, o chamado será obrigatoriamente atribuído a este grupo, e o usuário não poderá alterá-lo."

#: src/Controller/EntityController.php
msgid "Select a valid assigned group when group assignment is required."
msgstr "Selecione um grupo atribuído válido quando a atribuição a um grupo for exigida."

#: src/Controller/TicketController.php
msgid "No assigned group is configured for this entity. Contact an administrator."
msgstr "Nenhum grupo atribuído está configurado para esta entidade. Contate um administrador."

#: hook.php
msgid "Profile permissions successfully updated."
msgstr "Permissões do perfil atualizadas com sucesso."

#: templates/settings.html.twig
msgid "Entities"
msgstr "Entidades"

#: templates/settings.html.twig
msgid "Profiles"
msgstr "Perfis"

#: templates/settings.html.twig
msgid "Groups"
msgstr "Grupos"

#: templates/settings_entities.html.twig
msgid "Entities with this configuration"
msgstr "Entidades com essa configuração"

#: templates/settings_profiles.html.twig
msgid "Profiles with this configuration"
msgstr "Perfis com essa configuração"

#: templates/settings_groups.html.twig
msgid "Default assigned group"
msgstr "Grupo atribuído padrão"

#: templates/settings_groups.html.twig
msgid "This is the group selected in the Entities tab. To change it, update the configuration in the Entities tab."
msgstr "Este é o grupo escolhido na aba Entidades. Para alterá-lo, mude a configuração na aba Entidades."

#: templates/settings_groups.html.twig
msgid "No assigned group is configured. Configure it in the Entities tab before saving group memberships."
msgstr "Nenhum grupo atribuído está configurado. Configure-o na aba Entidades antes de salvar os membros dos grupos."

#: templates/settings_groups.html.twig
msgid "Groups whose members will be added to the default assigned group"
msgstr "Grupos cujos membros serão adicionados ao grupo atribuído padrão"

#: templates/settings.html.twig
msgid "Loading..."
msgstr "Carregando..."

#: public/js/pluginSettings.js
msgid "Saving, this may take a while..."
msgstr "Salvando, isso pode demorar um pouco..."

#: public/js/pluginSettings.js
msgid "The operation failed. Please try again."
msgstr "A operação falhou. Tente novamente."

#: front/config.ajax.php
msgid "Invalid settings action."
msgstr "Ação de configuração inválida."

#: front/config.ajax.php
msgid "Entity settings successfully updated."
msgstr "Configurações das entidades atualizadas com sucesso."

#: front/config.ajax.php
msgid "Profile settings successfully updated."
msgstr "Configurações dos perfis atualizadas com sucesso."

#: front/config.ajax.php
msgid "Group memberships successfully updated."
msgstr "Membros dos grupos atualizados com sucesso."

#: front/config.ajax.php
msgid "Select at least one entity."
msgstr "Selecione pelo menos uma entidade."

#: front/config.ajax.php
msgid "Select at least one profile."
msgstr "Selecione pelo menos um perfil."

#: front/config.ajax.php
msgid "Select at least one source group."
msgstr "Selecione pelo menos um grupo de origem."

#: front/config.ajax.php
msgid "Select an assigned group before saving."
msgstr "Selecione um grupo atribuído antes de salvar."

#: front/config.ajax.php
msgid "The assigned group must be available in every selected entity. Unavailable in: %s"
msgstr "O grupo atribuído deve estar disponível em todas as entidades selecionadas. Indisponível em: %s"

#: front/config.ajax.php
msgid "The default category must be available in every selected entity. Unavailable in: %s"
msgstr "A categoria padrão deve estar disponível em todas as entidades selecionadas. Indisponível em: %s"

#: front/config.ajax.php
msgid "One or more selected entities do not exist."
msgstr "Uma ou mais entidades selecionadas não existem."

#: front/config.ajax.php
msgid "One or more selected profiles do not exist."
msgstr "Um ou mais perfis selecionados não existem."

#: front/config.ajax.php
msgid "One or more selected groups do not exist."
msgstr "Um ou mais grupos selecionados não existem."

#: front/config.ajax.php
msgid "Choose the assigned group in the Entities tab before saving."
msgstr "Escolha o grupo atribuído na aba Entidades antes de salvar."

#: front/config.ajax.php
msgid "The configured assigned group no longer exists. Update it in the Entities tab."
msgstr "O grupo atribuído configurado não existe mais. Atualize-o na aba Entidades."

#: front/config.ajax.php
msgid "You do not have permission to update the configured assigned group."
msgstr "Você não tem permissão para atualizar o grupo atribuído configurado."

#: front/config.ajax.php
msgid "A user could not be added to the configured assigned group."
msgstr "Não foi possível adicionar um usuário ao grupo atribuído configurado."

#: front/config.ajax.php
msgid "Profile permissions could not be saved."
msgstr "Não foi possível salvar as permissões dos perfis."

#: front/config.ajax.php
msgid "Invalid selection."
msgstr "Seleção inválida."

#: front/config.ajax.php
msgid "The operation failed. No changes were applied."
msgstr "A operação falhou. Nenhuma alteração foi aplicada."

#: public/js/pluginSettings.js
msgid "Check all"
msgstr "Marcar todos"

#: public/js/pluginSettings.js
msgid "Uncheck all"
msgstr "Desmarcar todos"
